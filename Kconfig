# Kconfig definition for Zephyr Modem Protocols and Console Integration.

menu "Zephyr Modem Protocols"

config MODEM_XMODEM
	bool "XMODEM Protocol"
	default y
	select CRC
	help
	  Enable XMODEM protocol engine (128-byte and 1K blocks, CRC16 and Checksum).

if MODEM_XMODEM

config MODEM_XMODEM_BLOCK_SIZE_1024
	bool "Use 1024-byte blocks by default (XMODEM-1K)"
	default y
	help
	  When enabled, XMODEM uses 1024-byte payload blocks. Otherwise 128-byte blocks are used.

config MODEM_XMODEM_USE_CRC
	bool "Use CRC16 by default"
	default y
	help
	  When enabled, XMODEM negotiates CRC16 mode ('C'). Otherwise 8-bit checksum is used.

endif # MODEM_XMODEM

config MODEM_YMODEM
	bool "YMODEM Protocol"
	default y
	select CRC
	help
	  Enable YMODEM protocol engine (Block 0 file metadata, batch transfer).

config MODEM_ZMODEM
	bool "ZMODEM Protocol"
	default y
	select CRC
	help
	  Enable ZMODEM protocol engine (streaming binary/hex frames, ZDLE escape).

if MODEM_ZMODEM

config MODEM_ZMODEM_USE_CRC32
	bool "Enable 32-bit CRC by default for ZMODEM"
	default y
	help
	  When enabled, ZMODEM uses 32-bit CRC (ZBIN32). Otherwise 16-bit CRC is used.

config MODEM_ZMODEM_ESCAPE_CTRL_CHARS
	bool "Escape control characters (XON/XOFF) in ZMODEM"
	default y
	help
	  When enabled, ZMODEM escapes control characters via ZDLE to support software flow control.

config MODEM_AUTO_START
	bool "ZMODEM Auto-Start Detection"
	default y
	help
	  Enable background monitoring of console input stream for ZMODEM initiation sequence.

endif # MODEM_ZMODEM

config MODEM_PACKET_TIMEOUT_MS
	int "Default Packet Response Timeout (ms)"
	default 3000
	help
	  Default timeout in milliseconds waiting for packet responses.

config MODEM_BYTE_TIMEOUT_MS
	int "Default Inter-byte Timeout (ms)"
	default 1000
	help
	  Default inter-byte reception timeout in milliseconds.

config MODEM_MAX_RETRIES
	int "Default Maximum Packet Retries"
	default 10
	help
	  Default maximum number of retransmissions for failed or corrupted packets.

config MODEM_INTER_BLOCK_DELAY_MS
	int "Inter-block Transmit Delay (ms)"
	default 0
	help
	  Configurable transmit delay in milliseconds inserted between transmitted blocks.

config MODEM_HANDSHAKE_DELAY_MS
	int "Handshake Retry Delay (ms)"
	default 1000
	help
	  Configurable delay in milliseconds between initial handshake retry attempts.

config MODEM_FILE_OVERWRITE_MODE
	int "Default File Overwrite Mode (0=Overwrite, 1=Skip, 2=Abort)"
	default 0
	help
	  File overwrite policy when target file exists: 0 for Overwrite, 1 for Skip, 2 for Abort.

config MODEM_ENABLE_RESUME
	bool "Enable ZMODEM file transfer auto-resume by default"
	default y
	help
	  When enabled, ZMODEM uses ZRPOS file offset to resume interrupted transfers.

config MODEM_DEFAULT_TARGET_DIR
	string "Default Target Directory Path"
	default ""
	help
	  Default storage directory path on target file system for received files.

config MODEM_SYNC_INTERVAL_BLOCKS
	int "File Storage Sync Interval (in blocks, 0=at end)"
	default 10
	help
	  Interval in received payload blocks between calling storage file sync.

config MODEM_ASYNC_STORAGE
	bool "Async Storage Writes via Zephyr Workqueue (k_work)"
	default y
	help
	  Offload file system write operations to a background Zephyr workqueue thread.

config MODEM_PROGRESS_BAR
	bool "Real-time Shell Progress Bar & Metrics"
	default y
	help
	  Render transfer percentage, throughput (KB/s), elapsed time, and ETA on shell console.

config MODEM_DIRECTORY_TRANSFERS
	bool "Directory Batch Transfers"
	default y
	depends on FILE_SYSTEM
	help
	  Allow transmitting all files in a directory via YMODEM/ZMODEM batch transfers.

config MODEM_RING_BUFFER
	bool "Ring Buffer UART Transport Adapter"
	default y
	help
	  Use a Zephyr ring buffer for non-blocking UART byte reception with microsecond precision.

config MODEM_ABORT_KEY
	bool "Terminal Abort Key Monitoring (Ctrl-C / CAN CAN)"
	default y
	help
	  Monitor console stream during transfer for Ctrl-C or CAN CAN abort key sequences.

config MODEM_ABORT_KEY_CHAR
	int "Configurable Abort Key Character Code (ASCII)"
	default 3
	depends on MODEM_ABORT_KEY
	help
	  ASCII byte value used as the terminal abort key (default 3 for Ctrl-C / 0x03, 27 for ESC / 0x1B, 24 for CAN / 0x18).

config MODEM_CONSOLE
	bool "Zephyr Console Modem Protocol Integration"
	default y
	depends on FILE_SYSTEM
	depends on MODEM_XMODEM || MODEM_YMODEM || MODEM_ZMODEM
	help
	  Enable shell integration for serial modem transfers and configuration.

endmenu
