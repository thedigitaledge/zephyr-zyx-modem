# Kconfig definition for Zephyr Modem Protocols and Console Integration.

menu "Zephyr Modem Protocols"

config MODEM_XMODEM
	bool "XMODEM Protocol"
	default y
	select CRC
	help
	  Enable XMODEM protocol engine (128-byte and 1K blocks, CRC16 and Checksum).

config MODEM_YMODEM
	bool "YMODEM Protocol"
	default y
	select CRC
	help
	  Enable YMODEM protocol engine (Block 0 file metadata, batch transfer).

config MODEM_ZMODEM
	bool "ZMODEM Protocol"
	default y
	select CRC
	help
	  Enable ZMODEM protocol engine (streaming binary/hex frames, ZDLE escape).

config MODEM_PACKET_TIMEOUT_MS
	int "Default Packet Response Timeout (ms)"
	default 3000
	help
	  Default timeout in milliseconds waiting for packet responses.

config MODEM_BYTE_TIMEOUT_MS
	int "Default Inter-byte Timeout (ms)"
	default 1000
	help
	  Default inter-byte reception timeout in milliseconds.

config MODEM_MAX_RETRIES
	int "Default Maximum Packet Retries"
	default 10
	help
	  Default maximum number of retransmissions for failed or corrupted packets.

config MODEM_CONSOLE
	bool "Zephyr Console Modem Protocol Integration"
	default y
	depends on FILE_SYSTEM
	depends on MODEM_XMODEM || MODEM_YMODEM || MODEM_ZMODEM
	help
	  Enable shell integration for serial modem transfers and configuration.

endmenu
