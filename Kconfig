# Kconfig definition for Zephyr Modem Protocols and Console Integration.

menu "Zephyr Modem Protocols"

config MODEM_XMODEM
	bool "XMODEM Protocol"
	default y
	select CRC
	help
	  Enable XMODEM protocol engine (128-byte and 1K blocks, CRC16 and Checksum).

config MODEM_YMODEM
	bool "YMODEM Protocol"
	default y
	select CRC
	help
	  Enable YMODEM protocol engine (Block 0 file metadata, batch transfer).

config MODEM_ZMODEM
	bool "ZMODEM Protocol"
	default y
	select CRC
	help
	  Enable ZMODEM protocol engine (streaming binary/hex frames, ZDLE escape).

config MODEM_CONSOLE
	bool "Zephyr Console Modem Protocol Integration"
	default y
	depends on FILE_SYSTEM
	depends on MODEM_XMODEM || MODEM_YMODEM || MODEM_ZMODEM
	help
	  Enable shell commands (`modem rx`/`mrx`, `modem tx`/`mtx`) and
	  Zephyr console integration for serial file uploads and downloads.

endmenu
